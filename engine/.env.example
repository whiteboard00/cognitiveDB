# Cognition Engine API - Environment Configuration
# Copy this file to .env and fill in your actual values

# ===== REQUIRED SETTINGS =====
# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI API for embeddings
OPENAI_API_KEY=your-openai-api-key

# Master API Key for admin operations (generate a secure random key)
MASTER_API_KEY=your-secure-master-key-here

# ===== OPTIONAL SETTINGS =====
# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Vector Database Configuration
VECTOR_DB_TYPE=chromadb
VECTOR_DB_URL=./chroma_db
VECTOR_DB_PERSIST=true

# Security Settings
CORS_ORIGINS=*
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10485760

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=

# Monitoring
SENTRY_DSN=
ENABLE_METRICS=true
METRICS_PORT=9090

# Billing (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ENABLED=false

# ===== DEVELOPMENT SETTINGS =====
# Set these for local development
DEBUG=true
RELOAD=true
